table Bills
	lineageTag: 9296889b-2d94-5da0-825c-4e694bcff69e

	/// Average monthly bill across the months in context. With no month filter this is the 12-month average, which matters for Duke's seasonal rates.
	measure 'Monthly Bill' = AVERAGE ( Bills[total_bill] )
		formatString: \$#,0.00
		lineageTag: ebe423de-d647-559c-887b-5c598669cef6

	/// Usage chosen in the Usage Level slicer; 1,000 kWh when nothing or several values are selected.
	measure 'Selected kWh' = SELECTEDVALUE ( 'Usage Level'[kWh], 1000 )
		formatString: #,0
		lineageTag: b59eed38-c559-5b14-abde-470f2dd5abbe

	/// Monthly bill at the usage chosen in the slicer.
	measure 'Bill at Selected Usage' =
			VAR k = [Selected kWh]
			RETURN
			    CALCULATE ( [Monthly Bill], Bills[kwh] = k )
		formatString: \$#,0.00
		lineageTag: c62d7ba7-c1c9-57f1-b3f7-46d1b00a62b7

	/// All-in cents per kWh at the selected usage.
	measure 'Cents per kWh at Selected Usage' =
			VAR k = [Selected kWh]
			RETURN
			    IF ( k > 0, DIVIDE ( [Bill at Selected Usage], k ) * 100 )
		formatString: 0.00
		lineageTag: 1328e3a9-09f2-5ca1-91d8-4f96bdaffbfc

	/// Lowest bill among the utilities currently shown.
	measure 'Lowest Bill at Selected Usage' = MINX ( ALLSELECTED ( Utilities[utility] ), [Bill at Selected Usage] )
		formatString: \$#,0.00
		lineageTag: 6d9156c4-a73b-52c4-b0c3-fa03a8e7cacb

	/// How much more this utility's bill is than the lowest one shown.
	measure 'Difference vs Lowest' =
			IF (
			    HASONEVALUE ( Utilities[utility] ),
			    [Bill at Selected Usage] - [Lowest Bill at Selected Usage]
			)
		formatString: \$#,0.00
		lineageTag: 4ad422f1-fc05-510f-9575-64d2768ec3f3

	measure 'Rank (1 = lowest)' =
			IF (
			    HASONEVALUE ( Utilities[utility] ),
			    RANKX ( ALLSELECTED ( Utilities[utility] ), [Bill at Selected Usage], , ASC, DENSE )
			)
		formatString: 0
		lineageTag: 20ed1035-486b-594b-bce8-12cb3f9694f8

	/// Share of the bill that is fuel or purchased-power cost.
	measure 'Fuel Share at Selected Usage' =
			VAR k = [Selected kWh]
			RETURN
			    DIVIDE ( CALCULATE ( AVERAGE ( Bills[fuel] ), Bills[kwh] = k ), [Bill at Selected Usage] )
		formatString: 0.0%
		lineageTag: 26795141-e542-56b3-b914-afc1a19c5118

	column tariff_key
		dataType: string
		isHidden
		lineageTag: 7552f580-a7f2-5e2b-b679-3bfa4f86cfb2
		summarizeBy: none
		sourceColumn: tariff_key

	column kwh
		dataType: int64
		formatString: #,0
		lineageTag: 9568b894-e8da-52c2-a98c-c7b6a10f46a8
		summarizeBy: none
		sourceColumn: kwh

	column month
		dataType: int64
		isHidden
		lineageTag: dc4ddfc2-db86-5150-a224-85373fc853b5
		summarizeBy: none
		sourceColumn: month

	column total_bill
		dataType: double
		lineageTag: 80c35d3e-5268-5d2a-a6b9-c6562363ee66
		summarizeBy: none
		sourceColumn: total_bill

	column customer_charge
		dataType: double
		lineageTag: 24f5c447-44bf-56ab-b4ed-9d5115826340
		summarizeBy: none
		sourceColumn: customer_charge

	column demand_level_charge
		dataType: double
		lineageTag: 4822c555-7ede-5943-91f2-877851e6717a
		summarizeBy: none
		sourceColumn: demand_level_charge

	column energy_non_fuel
		dataType: double
		lineageTag: 5ff83cd7-deeb-5069-ae89-4f0c966f16cb
		summarizeBy: none
		sourceColumn: energy_non_fuel

	column fuel
		dataType: double
		lineageTag: 71cb83ad-bdd6-5e54-b23d-747d902282be
		summarizeBy: none
		sourceColumn: fuel

	column other_clauses
		dataType: double
		lineageTag: 8845d22b-0f36-5142-adb3-fcac238a5728
		summarizeBy: none
		sourceColumn: other_clauses

	column minimum_adjustment
		dataType: double
		lineageTag: 8ced1e6f-3f26-541f-9b3e-7d7eaba2f1a4
		summarizeBy: none
		sourceColumn: minimum_adjustment

	partition Bills = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataLocation, "http") then Web.Contents(DataLocation & "bills.csv") else File.Contents(DataLocation & "bills.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tariff_key", type text}, {"kwh", Int64.Type}, {"month", Int64.Type}, {"total_bill", type number}, {"customer_charge", type number}, {"demand_level_charge", type number}, {"energy_non_fuel", type number}, {"fuel", type number}, {"other_clauses", type number}, {"minimum_adjustment", type number}}, "en-US")
				in
				    Typed

