	partition Validation = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataLocation, "http") then Web.Contents(DataLocation & "validation.csv") else File.Contents(DataLocation & "validation.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tariff_key", type text}, {"kwh", Int64.Type}, {"calculator", type number}, {"published", type number}, {"difference", type number}, {"source", type text}, {"note", type text}}, "en-US")
				in
				    Typed

