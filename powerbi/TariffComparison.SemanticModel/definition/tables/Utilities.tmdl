	partition Utilities = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataLocation, "http") then Web.Contents(DataLocation & "utilities.csv") else File.Contents(DataLocation & "utilities.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tariff_key", type text}, {"utility", type text}, {"short_name", type text}, {"schedule", type text}, {"type", type text}, {"jurisdiction", type text}, {"effective", type text}, {"seasonal", type logical}, {"demand_level_charge", type logical}, {"tiered", type logical}, {"source_1", type text}}, "en-US")
